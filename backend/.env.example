# Copy this file to .env and fill in your values.
# IMPORTANT: The MongoDB credentials that were previously committed (kanban_admin / Password1234
# on cluster0.ydg9arf.mongodb.net) were exposed in version control — rotate that Atlas password now.

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<AppName>
JWT_SECRET=<generate-a-long-random-string-e.g.-openssl-rand-hex-32>
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
